# ===============================================
# TELEGRAM AUTO ACCEPT BOT CONFIGURATION
# ===============================================

# Your Telegram Bot Token obtained from @BotFather
BOT_TOKEN=your_bot_token_here

# Comma-separated Telegram User IDs of Bot Administrators / Owners
# Example: 123456789,987654321
ADMIN_IDS=123456789

# Global Force Subscribe Channels (Optional)
# Comma-separated channel @usernames or chat IDs that users must join before using the bot.
# Example: @MyChannel, @AnotherChannel, -1001234567890
# Note: The bot MUST be an Administrator in these channels to verify member status.
FORCE_SUB_CHANNELS=

# ===============================================
# OPTIONAL: MTProto Client (For Bulk / Backlog Join Requests)
# Required only if you want to click "Approve All Pending Requests"
# to approve existing requests created before bot was added.
# Get API_ID and API_HASH for free at https://my.telegram.org
# ===============================================
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
SESSION_STRING=

# Default Welcome Direct Message sent to users when their join request is approved
# Available placeholders:
# {name} - User's full name
# {first_name} - User's first name
# {username} - User's @username (or first name if no username)
# {mention} - Markdown mention link to the user
# {chat_title} - Name of the channel/group joined
DEFAULT_WELCOME_MESSAGE=👋 Hello {name}!\n\n🎉 Your request to join *{chat_title}* has been **approved**.\n\nWelcome aboard! Enjoy your stay. ✨

# Path to SQLite database file
DATABASE_PATH=bot_database.sqlite3

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
